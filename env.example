# Exemplo de variáveis de ambiente para o monorepo Interactive Restaurantes
# Copie este arquivo para .env na raiz e preencha os valores reais localmente.

# Backend
PORT=3001
DATABASE_URL=
JWT_SECRET=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
AI_MODULE_API_KEY=
AI_ASR_URL=http://localhost:8000/asr
AI_TTS_URL=http://localhost:8000/tts
AI_AUDIO_DIR=uploads/ai-audio

# AI Bridge (NVIDIA gRPC)
NVIDIA_ASR_FUNCTION_ID=b702f636-f60c-4a3d-a6f4-f3568c13bd7d
NVIDIA_TTS_FUNCTION_ID=
NVIDIA_GRPC_TARGET=grpc.nvcf.nvidia.com:443
NVIDIA_GRPC_USE_SSL=true

# Client Web
REACT_APP_API_BASE_URL=

# Admin Panel
VITE_API_URL=http://localhost:3000/api

# Ads Module
ADS_DB_PATH=
